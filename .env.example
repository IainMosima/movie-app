# Explicit override for where app data (library.json, settings.json, sources.json,
# cache/) lives. Optional — defaults to ./data next to the project. Also read by
# docker-compose.yml under the name MEDIA_ROOT (see below) to pick the host folder
# to bind-mount.
# DATA_DIR=/path/to/data

# Root directory the in-app Settings > Data Directory folder picker browses within,
# and where its runtime "active directory" pointer file is stored. In Docker this is
# also the host directory docker-compose bind-mounts into the container. Optional —
# defaults to the project directory locally, or /app/data inside the container.
# MEDIA_ROOT=/path/to/media/root
